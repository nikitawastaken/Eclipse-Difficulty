<effect force_synch="false">
    <atom name="birds" min_size="20" max_size="20" lifetime="-1" random_start_time="false" start_time="0" preroll="1" inherit_velocity_multiplier="1" fade_in_start="-1" fade_in_length="0" fade_out_start="-1" spawn_cull_policy="initialize" cull_policy="freeze" cull_gracetime="0" max_particle_radius="-1" soundbank="" cue="" ambient="false" grab_relative="effect" grab_pos="0 0 0" grab_radius="200" grab_backfacing="false" timeline="">
        <initializerstack>
            <boxrandomposition relative="effect" min="-150 -150 -150" max="150 150 150"/>
            <boxrandomvelocity relative="effect" min="-150 -150 -150" max="150 150 150"/>
            <boxrandomaspectsize size="35 35" min="0.5" max="1.5"/>
            <boxrandomanglevelocity min="0" max="0"/>
            <boxrandomangle min="0" max="0"/>
            <boxrandomrotation relative="effect" min="-10 -10 1" max="10 10 1" min_rot="0" max_rot="365"/>
            <constantage age="99999"/>
            <boxrandomcolorgradient color="68 68 68" min="0" max="0.46000000834465"/>
        </initializerstack>
        <simulatorstack>
            <velocityintegrator channel="world"/>
            <anglevelocityintegrator/>
            <rotationbyvelocity velocity="10000"/>
            <teleporter name="" trigger_teleport="time" lifetime_input="constant" particle_lifetime="35" teleport_cap="3" current_position="true" channel="world" normal_variation="0" teleport_event="false" positioner="box">
                <box min="-600 -600 -600" max="600 600 600" min_normal="150 150 -100" max_normal="300 300 100"/>
                <normal min_velocity="100" max_velocity="220"/>
            </teleporter>
            <ager/>
        </simulatorstack>
        <visualizerstack>
            <billboard texture="effects/textures/birds_df" intensity="editor_headlight" billboard_type="normal_locked" rotation_channel="world_rotation" blend_mode="normal" render_template="effect_op" origo="0.5 0.5" per_particle_age="true" size_input="channel" color_input="channel" opacity_input="keys" rotation_input="channel" rotation_axis="0 0 1" uv_size="0.0625 1" uv_offset_input="keys" frame_start="0 0" primary_step_direction="+y" secondary_step_direction="+x" num_frames="16" fps="30" loop="true">
                <opacity_keys loop="false">
                    <key t="0" v="0"/>
                    <key t="1.0152283906937" v="255"/>
                    <key t="33.84094619751" v="255"/>
                    <key t="36.097560882568" v="0"/>
                </opacity_keys>
