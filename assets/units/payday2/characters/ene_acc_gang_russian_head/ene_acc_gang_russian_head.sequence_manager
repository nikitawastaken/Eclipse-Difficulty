<?xml version="1.0"?>
<table>
	<unit>	
		<variables>
			<material_var				value="0" />
		</variables>

		<filter name="'check_mat_var1'">
			<check value="vars.material_var == 1" />
		</filter>
		
		<filter name="'check_mat_var2'">
			<check value="vars.material_var == 2" />
		</filter>
		
		<sequence editable_state="true" name="'head_material_var1'" once="true" triggable="true"> 
			<set_variables 		material_var="1" />
			<material_config 	name="'units/payday2/characters/ene_acc_gang_russian_head/vars/ene_acc_gang_russian_head_var1'" synchronous="true" />
		</sequence>

		<sequence editable_state="true" name="'head_material_var2'" once="true" triggable="true"> 
			<set_variables 		material_var="2" />
			<material_config 	name="'units/payday2/characters/ene_acc_gang_russian_head/vars/ene_acc_gang_russian_head_var2'" synchronous="true" />
		</sequence>

		<sequence editable_state="true" name="'head_init'" once="true" triggable="true"> 
			<run_sequence	 	name="'random_body'" />
		</sequence>

		<sequence editable_state="true" name="'random_body'" once="true" triggable="true"> 
			<run_sequence		filter="'check_mat_var2'" name="'body_'..pick('a','b','c','d')..'_var2'" />
			<run_sequence		filter="'check_mat_var1'" name="'body_'..pick('a','b','c','d')..'_var1'" />
		</sequence>

		<sequence editable_state="true" name="'random_balaclava_any_rare'" once="true" triggable="true"> 
			<run_sequence 		name="'balaclava_'..pick('none','none','none','none','none','none','none','none','none','none','a','b','c','d')" />
		</sequence>
		
		<sequence editable_state="true" name="'random_balaclava_twohole_common'" once="true" triggable="true"> 
			<run_sequence 		name="'balaclava_'..pick('a','a','a','b','b','b','c','d','none','none')" />
		</sequence>

		<sequence editable_state="true" name="'random_balaclava_three_common'" once="true" triggable="true"> 
			<run_sequence 		name="'balaclava_'..pick('c','c','c','d','d','d','a','b','none','none')" />
		</sequence>

		<sequence editable_state="true" name="'balaclava_none'" once="true" triggable="true" >
			<run_sequence 		name="'disable_face'" />
		</sequence>
		
		<sequence editable_state="true" name="'balaclava_a'" once="true" triggable="true"> 
			<object 			enabled="true" name="'g_balaclava_a'" />
			<object 			enabled="true" name="'g_balaclava_a_lod1'" />
