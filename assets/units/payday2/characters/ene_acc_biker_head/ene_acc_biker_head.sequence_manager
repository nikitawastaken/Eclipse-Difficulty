<?xml version="1.0"?>
<table>
	<unit>	
		<variables>
			<material_var				value="0" />
		</variables>

		<filter name="'check_mat_var1'">
			<check value="vars.material_var == 1" />
		</filter>
		
		<filter name="'check_mat_var2'">
			<check value="vars.material_var == 2" />
		</filter>
		
		<sequence editable_state="true" name="'head_material_var1'" once="true" triggable="true"> 
			<set_variables 		material_var="1" />
			<material_config 	name="'units/payday2/characters/ene_acc_biker_head/vars/ene_acc_biker_head_var1'" synchronous="true" />
		</sequence>

		<sequence editable_state="true" name="'head_material_var2'" once="true" triggable="true"> 
			<set_variables 		material_var="2" />
			<material_config 	name="'units/payday2/characters/ene_acc_biker_head/vars/ene_acc_biker_head_var2'" synchronous="true" />
		</sequence>

		<sequence editable_state="true" name="'head_init'" once="true" triggable="true"> 
			<run_sequence	 	name="'random_body'" />
		</sequence>

		<sequence editable_state="true" name="'random_body'" once="true" triggable="true"> 
			<run_sequence		filter="'check_mat_var2'" name="'body_'..pick('a','b','c','d')..'_var2'" />
			<run_sequence		filter="'check_mat_var1'" name="'body_'..pick('a','b','c','d')..'_var1'" />
		</sequence>

		<sequence editable_state="true" name="'disable_arms'" once="true" triggable="true">	
			<object 		enabled="false" name="'g_arms'"/>
			<object 		enabled="false" name="'g_arms_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'disable_face'" once="true" triggable="true">	
		</sequence>
		
		<sequence editable_state="true" name="'disable_head'" once="true" triggable="true">	
			<object 		enabled="false" name="'g_head_a'"/>
			<object 		enabled="false" name="'g_head_a_lod1'"/>

			<object 		enabled="false" name="'g_head_b'"/>
			<object 		enabled="false" name="'g_head_b_lod1'"/>
			
			<object 		enabled="false" name="'g_head_c'"/>
			<object 		enabled="false" name="'g_head_c_lod1'"/>
			
			<object 		enabled="false" name="'g_head_d'"/>
			<object 		enabled="false" name="'g_head_d_lod1'"/>
		</sequence>
		
		<sequence editable_state="true" name="'body_a_var1'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>

			<object 		enabled="true" name="'g_head_a'"/>
			<object 		enabled="true" name="'g_head_a_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'body_b_var1'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>

			<object 		enabled="true" name="'g_head_b'"/>
			<object 		enabled="true" name="'g_head_b_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'body_c_var1'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>

			<object 		enabled="true" name="'g_head_c'"/>
			<object 		enabled="true" name="'g_head_c_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'body_d_var1'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>
		
			<object 		enabled="true" name="'g_head_d'"/>
			<object 		enabled="true" name="'g_head_d_lod1'"/>
		</sequence>
	
		<sequence editable_state="true" name="'body_a_var2'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>
		
			<object 		enabled="true" name="'g_head_a'"/>
			<object 		enabled="true" name="'g_head_a_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'body_b_var2'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>

			<object 		enabled="true" name="'g_head_b'"/>
			<object 		enabled="true" name="'g_head_b_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'body_c_var2'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>
	
			<object 		enabled="true" name="'g_head_c'"/>
			<object 		enabled="true" name="'g_head_c_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'body_d_var2'" once="true" triggable="true">
			<object 		enabled="true" name="'g_arms'"/>
			<object 		enabled="true" name="'g_arms_lod1'"/>
		
			<object 		enabled="true" name="'g_head_d'"/>
			<object 		enabled="true" name="'g_head_d_lod1'"/>
		</sequence>
	</unit>
</table>
