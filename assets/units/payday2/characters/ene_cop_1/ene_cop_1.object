			<lod_object name="lod_badges_fbi_b">
				<object name="g_badges_fbi_b" 		enabled="false"  max_distance="2000"  max_draw_lod="0" cpy_material_vars="contour_color, contour_opacity">
					<material materials="mtr_police_body" max_distance="1000" />
					<material materials="mtr_police_body_lod_1" max_distance="1500" />
					<material materials="mtr_police_body_lod_2" />
				</object>
				<object name="g_badges_fbi_b_lod1" 	enabled="false" lod="1" >
					<material materials="mtr_police_body" max_distance="0" cpy_material_vars="contour_color, contour_opacity" />
					<material materials="mtr_police_body_lod_2" />
