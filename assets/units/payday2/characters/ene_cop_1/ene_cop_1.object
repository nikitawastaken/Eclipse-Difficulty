			<lod_object name="lod_badges_cop_fat">
				<object name="g_badges_cop_fat" 		enabled="false"  max_distance="2000"  max_draw_lod="0" cpy_material_vars="contour_color, contour_opacity">
					<material materials="mtr_police_body" max_distance="1000" />
					<material materials="mtr_police_body_lod_1" max_distance="1500" />
					<material materials="mtr_police_body_lod_2" />
				</object>
				<object name="g_badges_cop_fat_lod1" 	enabled="false" lod="1" >
