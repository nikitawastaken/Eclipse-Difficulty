<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/payday2/weapons/wpn_npc_r870_taser/wpn_npc_r870_taser" orientation_object="rp_r870" />
	<sequence_manager file="units/payday2/weapons/wpn_npc_r870/wpn_npc_r870" />
	<bodies>
	<body name="body" enabled="false" template="debris" pushed_by_mover="false">
		<object name="rp_r870" />
		<object name="c_box" collision_type="box" mass="3" />
	</body>
	</bodies> 
	<graphics>
