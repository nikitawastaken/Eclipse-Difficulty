<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/pd2_dlc_pent/weapons/wpn_npc_flamethrower/wpn_npc_flamethrower" orientation_object="rp_wpn_npc_flamethrower" />
	  <sequence_manager file="units/pd2_dlc_pent/weapons/wpn_npc_flamethrower/wpn_npc_flamethrower" />
	  
  <bodies>
    <body name="body" enabled="false" template="debris" pushed_by_mover="false">
		<object name="rp_wpn_npc_flamethrower" />
		<object name="c_box" collision_type="box" mass="0.5" />
    </body>
  </bodies>

  <graphics>
	<graphic_group name="lod_group" enabled="true" culling_object="co_weapon">
      <lod_object name="weapon_lod">
        <object  name="g_body" enabled="true" max_draw_lod="0" max_distance="1800" />
        <object lod="1" name="g_body_lod1" enabled="true" />
      </lod_object>
    </graphic_group>
  </graphics> 

</dynamic_object>
