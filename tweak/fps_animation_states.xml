<?xml version="1.0"?>
<tweaks>
	<!-- Compact-5 Drum Magazine animation by Zdann -->
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
        <search>
            <xml/>
            <state name="fps/reload/mp5"/>
        </search>
        <target mode="attributes">
			<attr name="type" value="mix"/>
        </target>
    </tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
        <search>
            <xml/>
            <state name="fps/reload/mp5"/>
			<anim name="mp5_rifle_reload"/>
        </search>
        <target mode="replace">
			<anim name="mp5_rifle_reload" weight="mp5 * (1 - drum_mag)"/>
			<anim name="mp5_rifle_reload_drum" weight="mp5 * drum_mag"/>
        </target>
    </tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
        <search>
            <xml/>
            <state name="fps/reload_not_empty/mp5"/>
        </search>
        <target mode="attributes">
			<attr name="type" value="mix"/>
        </target>
    </tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
        <search>
            <xml/>
            <state name="fps/reload_not_empty/mp5"/>
			<anim name="mp5_rifle_reload_not_empty"/>
        </search>
        <target mode="replace">
			<anim name="mp5_rifle_reload_not_empty" weight="mp5 * (1 - drum_mag)"/>
			<anim name="mp5_rifle_reload_drum_not_empty" weight="mp5 * drum_mag"/>
        </target>
    </tweak>
