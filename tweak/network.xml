<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message/>
			<param type="int" min="0" max="512"/>
		</search>
		<target mode="attributes" multiple="true">
			<attr name="max" value="8192"/>
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="unit_traded"/>
			<param type="rotation"/>
		</search>
		<target mode="replace">
			<param type="rotation"/> <!-- look for the rotation node before inserting -->
			<param type="bool"/> <!-- custody trade? -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="hostage_trade"/>
			<param type="unit"/>
		</search>
		<target mode="replace">
			<param type="unit"/> <!-- look for the unit node before inserting -->
			<param type="bool"/> <!-- custody trade? -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a sync_assault_ponr message for `ConnectionHandler` -->
			<message name="sync_assault_ponr" delivery="ordered" receiver="connection" check="server_to_client" />
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a sync_trade_restore_resources message for `ConnectionHandler` -->
			<message name="sync_trade_restore_resources" delivery="ordered" receiver="connection" check="server_to_client" />
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a unit_suppressed message for `UnitHandler` -->
			<message name="unit_suppressed" delivery="ordered" receiver="unit">
				<param type="unit" />
				<param type="bool" />
			</message>
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="sync_drill_upgrades"/>
			<param type="unit"/>
		</search>
		<target mode="replace">
			<param type="unit"/> <!-- look for the unit node before inserting -->
			<param type="bool"/> <!-- electrocuting drill? -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="sync_spawn_extra_ammo"/>
			<param type="unit"/>
		</search>
		<target mode="replace">
			<param type="unit"/> <!-- look for the unit node before inserting -->
			<param type="bool"/> <!-- has extra dmg upgrade? -->
		</target>
	</tweak>
</tweaks>
