<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message/>
			<param type="int" min="0" max="512"/>
		</search>
		<target mode="attributes" multiple="true">
			<attr name="max" value="8192"/>
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="unit_traded"/>
			<param type="rotation"/>
		</search>
		<target mode="replace">
			<param type="rotation"/> <!-- look for the rotation node before inserting -->
			<param type="bool"/> <!-- custody trade? -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="hostage_trade"/>
			<param type="unit"/>
		</search>
		<target mode="replace">
			<param type="unit"/> <!-- look for the unit node before inserting -->
			<param type="bool"/> <!-- custody trade? -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a sync_assault_ponr message for `ConnectionHandler` -->
			<message name="sync_assault_ponr" delivery="ordered" receiver="connection" check="server_to_client" />
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a sync_trade_restore_resources message for `ConnectionHandler` -->
			<message name="sync_trade_restore_resources" delivery="ordered" receiver="connection" check="server_to_client" />
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a sync_damage_reduction_from_crewmate message for `ConnectionHandler` -->
			<message name="sync_damage_reduction_from_crewmate" delivery="ordered" receiver="connection" />
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a unit_suppressed message for `UnitHandler` -->
			<message name="unit_suppressed" delivery="ordered" receiver="unit">
				<param type="unit" />
				<param type="bool" />
			</message>
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- create a unit_set_focus_enemy_unit message for `UnitHandler` -->
			<message name="unit_set_focus_enemy_unit" delivery="ordered" receiver="unit">
				<param type="unit" />
				<param type="unit" />
			</message>
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<!-- Create a sync_set_cloaker_goggles_on message for `UnitHandler` -->
			<message name="sync_set_cloaker_goggles_on" delivery="ordered" receiver="unit">
				<param type="unit" /> <!-- Enemy unit -->
				<param type="bool" /> <!-- Goggles on? -->
			</message>
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="sync_drill_upgrades"/>
			<param type="unit"/>
		</search>
		<target mode="replace">
			<param type="unit"/> <!-- look for the unit node before inserting -->
			<param type="bool"/> <!-- electrocuting drill? -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="sync_spawn_extra_ammo"/>
			<param type="unit"/>
		</search>
		<target mode="replace">
			<param type="unit"/> <!-- look for the unit node before inserting -->
			<param type="bool"/> <!-- has extra dmg upgrade? -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="server_drop_carry"/>
		</search>
		<target mode="attach">
			<param type="vector3"/> <!-- Add movement vector -->
		</target>
	</tweak>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<message name="eclipse_sync_carry_data" delivery="ordered" receiver="unit" check="server_to_client">
				<param type="unit" />
				<param type="string" />                <!-- Carry id -->
				<param type="int" min="0" max="2" />   <!-- multiplier upgrade level for small loot -->
				<param type="bool" />                  <!-- dye_initiated -->
				<param type="bool" />                  <!-- has_dye_pack -->
				<param type="int" min="0" max="100" /> <!-- dye_value_multiplier -->
				<param type="vector3" />               <!-- position -->
				<param type="vector3" />               <!-- direction -->
				<param type="int" min="0" max="1" />   <!-- Upgrade level of throw distance multiplier -->
				<param type="unit" />                  <!-- If attach to zipline -->
				<param type="int" min="0" max="128" /> <!-- peer_id extended to 128 for big lobby -->
				<param type="vector3" />			   <!-- movement -->
			</message>
		</target>
	</tweak>
	<!-- Add a custom "sync_hostage_interacted" message to allow clients to tell the server the amount of hostages they can have following -->
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<message name="sync_hostage_interacted" delivery="ordered" receiver="unit">
				<param type="unit" /> <!-- hostage unit -->
				<param type="int" min="0" max="15" /> <!-- max number of following hostages -->
				<param type="int" min="1" max="256" /> <!-- status -->
			</message>
		</target>
	</tweak>
	<!-- Rotating Cameras -->
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<message name="camera_rotation" delivery="ordered" receiver="unit">
				<param type="unit" />	<!-- camera unit -->
				<param type="int" min="0" max="255"/>   <!-- end yaw -->
				<param type="int" min="0" max="255"/>   <!-- end pitch -->
				<param type="bool" />     <!-- forced -->
				<param type="float" min="0" max="255" step="0.1" exact="false"/>    <!-- duration -->
			</message>
			<message name="camera_set_attention" delivery="ordered" receiver="unit" check="server_to_client">
				<param type="unit" />	<!-- observer unit -->
				<param type="unit" />	<!-- target unit -->
			</message>
			<message name="camera_set_attention_pos" delivery="ordered" receiver="unit" check="server_to_client">
				<param type="unit" />	<!-- camera unit -->
				<param type="vector3" />	<!-- target pos -->
			</message>
			<message name="camera_want_control" delivery="ordered" receiver="unit" check="client_to_server">
				<param type="unit" />	<!-- camera unit -->
				<param type="bool" />  	<!-- state -->
			</message>
			<message name="camera_control_state" delivery="ordered" receiver="unit" check="server_to_client">
				<param type="unit" />	<!-- camera unit -->
				<param type="int" min="0" max="15"/> <!-- peer id -->
				<param type="bool" />  	<!-- state -->
			</message>
		</target>
	</tweak>
	<!-- Sync ammo pickup upgrades -->
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<message name="eclipse_sync_pickup_upgrade" delivery="ordered" receiver="unit" check="server_to_client">
				<param type="unit" />
				<param type="bool" />                  <!-- upgrade -->
			</message>
		</target>
	</tweak>
	<!-- Add env string message -->
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<message name="eclipse_sync_environment" delivery="ordered" receiver="connection" check="server_to_client">
				<param type="string" />       <!-- environment_name -->
				<param type="string" />       <!-- color_grading -->
			</message>
		</target>
	</tweak>
</tweaks>
